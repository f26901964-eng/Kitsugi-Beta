default_platform(:android)

def release_signing_properties
  required = %w[KEYSTORE_FILE KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD]
  missing = required.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("Missing Android signing inputs: #{missing.join(', ')}") unless missing.empty?

  {
    "android.injected.signing.store.file" => ENV.fetch("KEYSTORE_FILE"),
    "android.injected.signing.store.password" => ENV.fetch("KEYSTORE_PASSWORD"),
    "android.injected.signing.key.alias" => ENV.fetch("KEY_ALIAS"),
    "android.injected.signing.key.password" => ENV.fetch("KEY_PASSWORD"),
  }
end

platform :android do
  desc "Build FOSS Debug APK"
  lane :internal do
    gradle(
      task: "assemble",
      flavor: "foss",
      build_type: "debug",
      print_command: false
    )
  end

  desc "Build and sign FOSS Release APK"
  lane :alpha do
    gradle(
      task: "assemble",
      flavor: "foss",
      build_type: "release",
      print_command: false,
      properties: release_signing_properties
    )
  end

  desc "Build and sign GMS Release APK"
  lane :beta do
    gradle(
      task: "assemble",
      flavor: "gms",
      build_type: "release",
      print_command: false,
      properties: release_signing_properties
    )
  end

  desc "Build and sign both FOSS and GMS Release APKs"
  lane :production do
    alpha
    beta
  end
end
